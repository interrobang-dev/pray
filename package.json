{
  "name": "jk-corp",
  "private": true,
  "workspaces": [
    "host",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n host,server,web \"npm:dev:host\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:host": "npm run dev --workspace host",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "test": "npm test --workspaces --if-present",
    "hooks:install": "node hooks/install.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
