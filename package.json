{
  "name": "pray",
  "private": true,
  "workspaces": [
    "host",
    "server",
    "web",
    "desktop",
    "mcp"
  ],
  "scripts": {
    "dev": "concurrently -n host,server,web \"npm:dev:host\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:host": "npm run dev --workspace host",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspace web",
    "desktop": "npm run start --workspace desktop",
    "hooks:install": "node hooks/install.mjs",
    "startup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-startup.ps1",
    "startup:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-startup.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron@44.9.1": true
  }
}
