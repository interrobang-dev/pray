<?xml version="1.0" encoding="utf-8"?>
<!-- 랜딩 PC 카드 하나. 누르면 그 PC 를 WebView 로 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/landing_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:minHeight="72dp"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/machine_dot"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/machine_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/landing_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/machine_last"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/landing_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Last opened"
            android:textColor="@color/landing_chip_text"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/machine_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/landing_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/machine_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/landing_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
